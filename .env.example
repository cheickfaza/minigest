# ─── Database ────────────────────────────────────────────────────────────────
# Production: Neon Postgres connection string (set automatically by the
# Vercel ↔ Neon integration). Leave empty locally to use the embedded PGlite
# database stored in ./.data/pglite (zero setup).
DATABASE_URL=

# ─── Admin authentication ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
# Generate with: npm run admin:hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
